---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import HeroIsland from '../components/islands/HeroIsland';
import ServicesIsland from '../components/islands/ServicesIsland';
import GalleryIsland from '../components/islands/GalleryIsland';
import AboutIsland from '../components/islands/AboutIsland';
import TestimonialsIsland from '../components/islands/TestimonialsIsland';
import ContactIsland from '../components/islands/ContactIsland';
---

<Layout>
  <Navbar />

  <!-- Hero carga inmediatamente — visible above the fold -->
  <HeroIsland client:load />

  <!-- El resto carga cuando entra al viewport -->
  <ServicesIsland client:visible />
  <GalleryIsland client:visible />
  <AboutIsland client:visible />
  <TestimonialsIsland client:visible />
  <ContactIsland client:visible />

  <!-- Footer estático — no necesita isla -->
  <footer class="bg-black text-gray-600 py-8 px-6 text-center text-sm tracking-widest uppercase">
    © 2026 Luminary Studio — All Rights Reserved
  </footer>
</Layout>
