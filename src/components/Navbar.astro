<nav class="fixed top-0 left-0 w-full z-50 px-8 py-6 flex justify-between items-center transition-all duration-500">
  <a href="#hero" class="text-white text-sm uppercase tracking-[0.3em] font-semibold">Luminary Studio</a>
  <ul class="hidden md:flex gap-10 text-sm uppercase tracking-widest text-gray-400">
    <li><a href="#services" class="hover:text-white transition-colors duration-300">Services</a></li>
    <li><a href="#gallery" class="hover:text-white transition-colors duration-300">Work</a></li>
    <li><a href="#about" class="hover:text-white transition-colors duration-300">About</a></li>
    <li><a href="#contact" class="hover:text-white transition-colors duration-300">Contact</a></li>
  </ul>
</nav>

<script>
  const nav = document.querySelector('nav');
  window.addEventListener('scroll', () => {
    if (window.scrollY > 50) {
      nav.classList.add('bg-black/80', 'backdrop-blur-sm');
    } else {
      nav.classList.remove('bg-black/80', 'backdrop-blur-sm');
    }
  });
</script>